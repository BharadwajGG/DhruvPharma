rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the user authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: is the user a server-verified Administrator (via Firebase custom claims)?
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Helper: does the request belong to the resource owner?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── 1. Admin-Only Collections ──
    // Inventory, financial reports, operational settings: Admins only
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
    match /inventory/{medicineId} {
      allow read: if true; // Public catalog can view medicine inventory
      allow write: if isAdmin(); // Only admins can edit prices, stock, batches
    }

    // ── 2. Prescriptions Collection ──
    match /prescriptions/{prescriptionId} {
      // Patients can create (upload) their own prescriptions
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Patient can read their own prescription; Staff/Admin can read queue
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      // Only admins / verified staff can update status (Approve/Reject)
      allow update, delete: if isAdmin();
    }

    // ── 3. Customer Orders ──
    match /orders/{orderId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ── 4. User Profiles ──
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      // Public users cannot write custom claims or elevate roles
      allow update: if isOwner(userId) && !('admin' in request.resource.data);
    }
  }
}

