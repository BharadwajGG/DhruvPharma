# Dhruv Pharma Backend Production Environment Configuration

# Server Settings
PORT=8000
ENVIRONMENT=production
CORS_ALLOWED_ORIGINS=https://dhruvpharma.com,https://www.dhruvpharma.com,https://dhruv-pharma.vercel.app

# Database (Default: SQLite local, or PostgreSQL connection string)
DATABASE_URL=sqlite:///./dhruv_pharma.db
# Example Postgres: postgresql://user:password@host:5432/dhruv_pharma

# Cashfree Payment Gateway Credentials
# Sandbox keys: https://merchant.cashfree.com/
# Production: set CASHFREE_ENV=PROD
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=TEST

# Pharmacist Email & Alert Notifications (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
ADMIN_NOTIFICATION_EMAIL=
